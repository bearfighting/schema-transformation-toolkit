{
  "name": "@schema-transformation-toolkit/parser-openapi",
  "version": "0.7.0",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "schemaTransformationToolkit": {
    "registry": {
      "version": 1,
      "entries": [
        {
          "role": "parser",
          "export": "openApiParserDescriptor"
        }
      ]
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@schema-transformation-toolkit/core": "workspace:*",
    "@schema-transformation-toolkit/parser-json-schema": "workspace:*",
    "yaml": "^2.8.1"
  },
  "scripts": {
    "build": "tsup --config ../../../tsup.config.ts",
    "clean": "rm -rf dist"
  }
}
